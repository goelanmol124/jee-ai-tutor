# --- Server (Express: npm run server / dev:full) ---
# OpenRouter preferred when set (OpenAI-compatible). Takes precedence over xAI.
OPENROUTER_API_KEY=
# Role-split OpenRouter models (Jul 2026 catalog):
# OPENROUTER_DIAGNOSE_MODEL=openai/gpt-5.4-mini
# OPENROUTER_COACH_MODEL=anthropic/claude-sonnet-5
# OPENROUTER_TUTOR_MODEL=anthropic/claude-sonnet-5
# OPENROUTER_TOOL_MODEL=google/gemini-2.5-flash-lite
# Cheaper diagnose: google/gemini-2.5-flash ; premium coach: anthropic/claude-opus-4.8
# Fallback if a role var is unset:
OPENROUTER_MODEL=google/gemini-2.5-flash-lite
# OPENROUTER_HTTP_REFERER=http://localhost:5173
# OPENROUTER_APP_TITLE=AdvancedLearning
#
# Or xAI Grok direct — also accepts XAI_API_KEY. Used only if OPENROUTER_API_KEY is unset.
# GROK_API_KEY=
GROK_MODEL=grok-4-1-fast-non-reasoning
# GROK_DIAGNOSE_MODEL=grok-4.20-0309-non-reasoning
# GROK_COACH_MODEL=grok-4.20-0309-non-reasoning
# GROK_TUTOR_MODEL=grok-4-1-fast-non-reasoning
# Optional: GROK_TUTOR_RETRIES=4    GROK_TUTOR_TIMEOUT_MS=120000

# Port the API listens on (Vite proxies /api here in dev).
AL_SERVER_PORT=8787

# --- Client tutor routing ---
# Leave unset for AUTO: the app calls GET /api/health and uses Grok when the server has a key
# (no need to duplicate settings in Vite).
# VITE_TUTOR_PROVIDER=mock   # force offline heuristics, never call /api/diagnose
# VITE_TUTOR_PROVIDER=grok   # always call the API (errors if the server has no key)

# --- Content / storage (all optional) ---
# Path to a full graph bundle built from your own question bank (git-ignored).
# Use AL_GRAPH_PATH=sample to force the bundled original sample graph.
# AL_GRAPH_PATH=
# VITE_GRAPH=sample            # client: ignore public/data/graph.json
# TUTOR_SQLITE_PATH=           # default app/data/tutor.sqlite
# PILOT_DATA_DIR=              # default app/data/pilot
